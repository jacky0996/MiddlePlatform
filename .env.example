# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_PORT=80

# CORS (frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# MySQL container
MYSQL_ROOT_PASSWORD=root_password

# Database connection (Django)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=platform_db
DB_USERNAME=developer
DB_PASSWORD=change-me

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MIN=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# EDM 整合
EDM_URL=http://localhost:82
EDM_LANDING_PATH=/sa-docs/uml

# Job Digger Admin 整合 (Laravel 後台,共用 SSO)
JOB_DIGGER_ADMIN_URL=http://localhost:8084
JOB_DIGGER_ADMIN_LANDING_PATH=/sso/callback

# =====================================================================
# Cloud Run 部署用的覆寫值(本機 docker-compose 不用設,雲端 service 才用)
# =====================================================================
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=*.run.app,<your-custom-domain>
# CSRF_TRUSTED_ORIGINS=https://*.run.app,https://<your-custom-domain>
#
# Cloud SQL 連線:HOST 改成 Unix socket 路徑,PORT 留空
# DB_HOST=/cloudsql/<project-id>:<region>:<instance-id>
# DB_PORT=
#
# Secret Manager(實際值不放 .env,在 Cloud Run service 設定 reference)
# DJANGO_SECRET_KEY    ← 從 Secret 讀取
# DB_PASSWORD          ← 從 Secret 讀取
# JWT_PRIVATE_KEY      ← 從 Secret 讀取(若用 RS256)
