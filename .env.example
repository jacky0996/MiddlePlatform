# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_PORT=80

# CORS (frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# MySQL container
MYSQL_ROOT_PASSWORD=root_password

# Database connection (Django)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=platform_db
DB_USERNAME=developer
DB_PASSWORD=change-me

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MIN=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# EDM 整合
EDM_URL=http://localhost:82
EDM_LANDING_PATH=/sa-docs/uml

# Job Digger Admin 整合 (Laravel 後台,共用 SSO)
JOB_DIGGER_ADMIN_URL=http://localhost:84
JOB_DIGGER_ADMIN_LANDING_PATH=/sso/callback
